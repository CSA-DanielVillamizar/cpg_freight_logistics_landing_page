# Copy to .env and adjust as needed. Consumed by docker-compose and (optionally) the API.
# The API reads configuration from appsettings*.json by default; these mirror those values.

CPG_ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=cpg;Username=cpg;Password=cpg_local_dev
CPG_ConnectionStrings__RabbitMq=amqp://cpg:cpg_local_dev@localhost:5672

# Azure Blob (Azurite well-known development connection string)
CPG_BlobStorage__Provider=Azure
CPG_BlobStorage__ConnectionString=UseDevelopmentStorage=true

# JWT signing key - generate a real 32+ byte secret per environment
CPG_Jwt__SigningKey=dev-only-cpg-enterprises-signing-key-please-override-32bytes+
