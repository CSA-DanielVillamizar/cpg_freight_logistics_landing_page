{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cpg;Username=cpg;Password=cpg_local_dev",
    "RabbitMq": "amqp://cpg:cpg_local_dev@localhost:5672"
  },
  "Jwt": {
    "Issuer": "cpg-enterprises",
    "Audience": "cpg-enterprises-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "BlobStorage": {
    "Provider": "Azure",
    "ConnectionString": "UseDevelopmentStorage=true",
    "LocalRootPath": "./.blob-store",
    "LocalPublicBaseUri": "http://localhost:5080/blobs"
  },
  "AllowedHosts": "*"
}
